# Claude API (news briefing)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed if your key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=

# Notion integration token (share your pages/databases with the integration)
NOTION_TOKEN=

# TomTom traffic (optional, free tier) - without it you get map links only
TOMTOM_KEY=

# Location (default Chichester)
LAT=50.8365
LON=-0.7792
PLACE=Chichester

# InfluxDB weather station (read-only token scoped to the bucket)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=home
INFLUX_BUCKET=enviro
INFLUX_TOKEN=
